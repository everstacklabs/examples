# Mock upstream: the deterministic model endpoint every gateway proxies to.
#
# Build context is the gateway-benchmark module root (see docker-compose.yml),
# so this builds from the module's own go.mod with no monorepo dependency.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/mockupstream ./cmd/mockupstream

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/mockupstream /mockupstream
EXPOSE 9800
ENTRYPOINT ["/mockupstream", "-addr", ":9800"]
